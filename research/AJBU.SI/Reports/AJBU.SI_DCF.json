  "scenario_narratives": {
    "base": "Data-centre rents keep escalating and reverting positively, offset by higher finance costs as hedges roll; per-unit AFFO grows ~3% fading to 2%, capitalised at a 7.5% cost of equity.",
    "bull": "Structural APAC/European supply shortage and AI inference demand sustain high reversions and redevelopment upside; AFFO/unit grows 4-5% early and the cost of equity compresses to 7%.",
    "bear": "Single-hyperscaler concentration bites: a renewal loss or rent reset cuts AFFO ~7% over two years, recovery is slow, and the market demands an 8.5% cost of equity."
  },
  "valuation_philosophy": {
    "summary": "A post-interest REIT distribution stream is worth what its owner AFFO (distributable income less capex reserves and fees paid in units) is worth capitalised at the unitholder's cost of equity. Debt is already paid inside the stream, so it is not deducted again. NAV per unit (1.73) is the asset-value cross-check.",
    "key_risks_to_valuation": [
      "Single hyperscaler = 43.5% of 1H2026 rental income; a lost renewal is the bear case",
      "Refinancing: 34% gearing, 71% hedged; each +100bp cuts ICR from 6.9x to 5.1x and DI by roughly 8-9m per 10% of debt repriced",
      "Finite land tenure on Singapore assets requires periodic lease-extension premiums outside DI",
      "Acquisition-led growth funded by unit issuance has delivered only 0.5-2.5% per-unit DPU growth despite 11-17% aggregate growth",
      "Multi-currency income (JPY, EUR, GBP, AUD, CNY) hedged only to June 2027"
    ]
  },
