{
 "kpis": [
  {
   "label": "Revenue (latest FY)",
   "column": "Revenue",
   "format": "money",
   "change": "yoy"
  },
  {
   "label": "Net Income",
   "column": "NetIncome",
   "format": "money",
   "change": "yoy"
  },
  {
   "label": "Free Cash Flow (reported)",
   "column": "FreeCashFlow",
   "format": "money",
   "change": "yoy"
  },
  {
   "label": "Owner FCF (DCF base)",
   "dcf_path": "inputs.last_fcf",
   "format": "money",
   "change": "after SBC, interest income & leases"
  },
  {
   "label": "Cash & Equivalents",
   "column": "CashAndEquivalents",
   "format": "money",
   "change": "yoy"
  },
  {
   "label": "Total Debt",
   "column": "TotalDebt",
   "format": "money",
   "change": "yoy",
   "positive": false
  },
  {
   "label": "Shares Outstanding (m)",
   "column": "SharesOutstanding",
   "format": "number",
   "change": "yoy",
   "positive": false
  },
  {
   "label": "EPS",
   "column": "EPS",
   "format": "number",
   "change": "yoy"
  }
 ],
 "sections": [
  {
   "title": "Growth & Profitability",
   "charts": [
    {
     "id": "revenueChart",
     "title": "Revenue & YoY Growth",
     "help": "revenue",
     "series": [
      {
       "label": "Revenue",
       "column": "Revenue",
       "kind": "bar"
      },
      {
       "label": "YoY %",
       "derive": "yoy:Revenue",
       "kind": "line",
       "axis": "y1",
       "color": "warning"
      }
     ],
     "log": true,
     "y1_title": "YoY %"
    },
    {
     "id": "marginsChart",
     "title": "Margins",
     "help": "margins",
     "series": [
      {
       "label": "Gross margin",
       "column": "GrossMargin",
       "kind": "line"
      },
      {
       "label": "Operating margin",
       "column": "OperatingMargin",
       "kind": "line"
      },
      {
       "label": "Net margin",
       "column": "NetMargin",
       "kind": "line"
      }
     ],
     "percent": true
    },
    {
     "id": "profitChart",
     "title": "Gross Profit, Operating Income & Net Income",
     "help": "profit",
     "log": true,
     "series": [
      {
       "label": "Gross profit",
       "column": "GrossProfit",
       "kind": "bar"
      },
      {
       "label": "Operating income",
       "column": "OperatingIncome",
       "kind": "bar"
      },
      {
       "label": "Net income",
       "column": "NetIncome",
       "kind": "bar"
      }
     ]
    },
    {
     "id": "ebitdaChart",
     "title": "EBITDA & EBITDA Margin",
     "help": "ebitda",
     "series": [
      {
       "label": "EBITDA",
       "column": "EBITDA",
       "kind": "bar"
      },
      {
       "label": "EBITDA %",
       "derive": "ratio:EBITDA/Revenue",
       "kind": "line",
       "axis": "y1",
       "color": "warning"
      }
     ],
     "log": true,
     "y1_title": "EBITDA %"
    },
    {
     "id": "epsDpsChart",
     "title": "EPS & Dividend per Share",
     "help": "epsDps",
     "series": [
      {
       "label": "EPS",
       "column": "EPS",
       "kind": "bar"
      },
      {
       "label": "Dividend per share",
       "column": "DividendPerShare",
       "kind": "bar"
      }
     ],
     "interim": false
    }
   ]
  },
  {
   "title": "Cash Flow & Balance Sheet",
   "charts": [
    {
     "id": "fcfChart",
     "title": "Net Income vs Free Cash Flow vs Owner FCF",
     "help": "fcf",
     "series": [
      {
       "label": "Net income",
       "column": "NetIncome",
       "kind": "bar"
      },
      {
       "label": "Reported FCF",
       "column": "FreeCashFlow",
       "kind": "bar"
      },
      {
       "label": "Owner FCF (DCF)",
       "dcf_path": "historical_growth.owner_fcf_history",
       "kind": "bar"
      }
     ],
     "annotation": "Owner FCF, where shown, is the DCF's series after SBC, interest income and lease principal."
    },
    {
     "id": "ocfCapexChart",
     "title": "Operating Cash Flow & CapEx",
     "help": "ocfCapex",
     "series": [
      {
       "label": "Operating cash flow",
       "column": "OperatingCashFlow",
       "kind": "bar"
      },
      {
       "label": "CapEx",
       "column": "CapEx",
       "kind": "bar"
      }
     ]
    },
    {
     "id": "cashDebtChart",
     "title": "Cash vs Total Debt",
     "help": "cashDebt",
     "series": [
      {
       "label": "Cash & equivalents",
       "column": "CashAndEquivalents",
       "kind": "bar"
      },
      {
       "label": "Total debt",
       "column": "TotalDebt",
       "kind": "bar"
      }
     ]
    },
    {
     "id": "balanceChart",
     "title": "Shareholders' Equity vs Total Liabilities",
     "help": "balanceSheet",
     "series": [
      {
       "label": "Total assets",
       "column": "TotalAssets",
       "kind": "line"
      },
      {
       "label": "Shareholders' equity",
       "column": "ShareholdersEquity",
       "kind": "line"
      },
      {
       "label": "Total liabilities",
       "column": "TotalLiabilities",
       "kind": "line"
      }
     ],
     "log": true
    },
    {
     "id": "sbcChart",
     "title": "Stock-Based Comp & Shares Outstanding",
     "help": "sbc",
     "series": [
      {
       "label": "Stock-based comp",
       "column": "StockBasedComp",
       "kind": "bar"
      },
      {
       "label": "Shares outstanding (m)",
       "column": "SharesOutstanding",
       "kind": "line",
       "axis": "y1"
      }
     ],
     "y1_title": "shares (m)"
    }
   ]
  }
 ]
}
